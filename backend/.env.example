DATABASE_URL=postgresql+asyncpg://postgres_username:postgres_password@localhost:5432/soft_translations_db
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
SECRET_KEY=replace-with-a-random-secret
ALGORITHM = 'HS256'
ACCESS_TOKEN_EXPIRE_MINUTES = 60
ACCESS_TOKEN_COOKIE_NAME=softtranslations_access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=softtranslations
MONGODB_TIMEOUT_MS=1000
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_BATCH_SIZE=25
# Uploads de anexos das solicitações (relativo à pasta do backend)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
MAX_FILES_PER_REQUEST=10
